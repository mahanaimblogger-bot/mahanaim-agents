# Copia este archivo como ".env" y completa tus propias claves.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# API key de DeepSeek (la consigues en https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Modelo de DeepSeek a usar. Verifica el nombre exacto vigente en
# https://api-docs.deepseek.com antes de correr en producción.
DEEPSEEK_MODEL=deepseek-chat

# URL de tu proyecto Supabase (Settings > API)
SUPABASE_URL=


# IMPORTANTE: esta es la "service_role key", NO la "anon key".
# La service_role key tiene permisos de escritura y NUNCA debe
# usarse en el frontend ni exponerse públicamente.
# Se consigue en Supabase > Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
