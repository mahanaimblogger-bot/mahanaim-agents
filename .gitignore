# Dependencias
node_modules/

# Variables de entorno
.env
.env.local

# Logs
*.log

# Carpeta de salida del pipeline
output/
!output/.gitkeep

# Archivos multimedia generados (en cualquier parte del repo)
*.mp3
*.wav
*.mp4

# Timestamps generados por TTS (en cualquier parte del repo)
*_timestamps.json

# Archivos temporales
tmp-*.mjs

# Contadores locales (migrados a Supabase)
audio-tts/contador-caracteres.json

# Scripts temporales de desarrollo
medir-estudio.js

# Archivos sueltos creados por error
/cd
/ffmpeg

# FFmpeg portable (no subir a GitHub)
tools/

# Backups de archivos
*.bak

# Scripts de prueba temporales
video/test-*.js
video/test-*.mp4

# ============================================
# PROMPTS_OUTPUT: Ignorar todo el contenido, pero permitir archivos de texto
# ============================================

# Ignorar todo lo que hay DENTRO de prompts_output/ (el asterisco es clave)
prompts_output/*

# PERMITIR (excepción) solo los archivos de texto ligeros que los workflows necesitan leer
!prompts_output/**/*.json
!prompts_output/**/*.ssml
!prompts_output/**/*.txt
!prompts_output/**/*.md
!prompts_output/**/*.html

# VOLVER A IGNORAR lo pesado dentro de esa carpeta
prompts_output/**/imagenes/
prompts_output/**/video/
prompts_output/**/*.mp3
prompts_output/**/*.mp4
prompts_output/**/*.wav
prompts_output/**/*_timestamps.json

# ============================================
# BACKUP: Ignorar carpeta de respaldo local
# ============================================
prompts_output_backup/