# Dependencias
node_modules/

# Variables de entorno
.env
.env.local

# Logs
*.log

# Carpeta de salida del pipeline
output/
!output/.gitkeep

# Artefactos generados por el orquestador
prompts_output/

# Archivos multimedia generados
*.mp3
*.wav
*.mp4

# Timestamps generados por TTS
*_timestamps.json

# Archivos temporales
tmp-*.mjs

# Contadores locales (migrados a Supabase)
audio-tts/contador-caracteres.json

# Scripts temporales de desarrollo
medir-estudio.js

# Archivos sueltos creados por error
/cd
/ffmpeg
# FFmpeg portable (no subir a GitHub)
tools/

# Backups de archivos
*.bak

# Scripts de prueba temporales
video/test-*.js
video/test-*.mp4

# ... (tus reglas actuales de node_modules, .env, etc. se quedan igual)

# 1. Ignorar la carpeta de salida por defecto
prompts_output/

# 2. PERMITIR (excepción) solo los archivos de texto ligeros que los workflows necesitan leer
!prompts_output/**/*.json
!prompts_output/**/*.ssml
!prompts_output/**/*.txt
!prompts_output/**/*.md
!prompts_output/**/*.html

# 3. VOLVER A IGNORAR lo pesado dentro de esa carpeta (aunque estén en prompts_output)
prompts_output/**/imagenes/
prompts_output/**/video/
prompts_output/**/*.mp3
prompts_output/**/*.mp4
prompts_output/**/*.wav
prompts_output/**/*_timestamps.json"prompts_output_backup/" 
