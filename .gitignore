# Dependencias
node_modules/

# Variables de entorno
.env
.env.local

# Logs
*.log

# Carpeta de salida del pipeline
output/
!output/.gitkeep

# Archivos multimedia generados (en cualquier parte del repo)
*.mp3
*.wav
*.mp4

# Timestamps generados por TTS (en cualquier parte del repo)
*_timestamps.json

# Archivos temporales
tmp-*.mjs

# Contadores locales (migrados a Supabase)
audio-tts/contador-caracteres.json

# Scripts temporales de desarrollo
medir-estudio.js

# Archivos sueltos creados por error
/cd
/ffmpeg

# FFmpeg portable (no subir a GitHub)
tools/

# Backups de archivos
*.bak

# Scripts de prueba temporales
video/test-*.js
video/test-*.mp4

# ============================================
# PROMPTS_OUTPUT: Configuración infalible
# ============================================

# 1. Ignorar todo el contenido de la carpeta
/prompts_output/*

# 2. PERMITIR que Git entre en las subcarpetas (¡ESTA ERA LA QUE FALTABA!)
!/prompts_output/**/

# 3. PERMITIR los archivos de texto específicos
!/prompts_output/**/*.json
!/prompts_output/**/*.ssml
!/prompts_output/**/*.txt
!/prompts_output/**/*.md
!/prompts_output/**/*.html

# 4. VOLVER A IGNORAR lo pesado dentro de esas subcarpetas
/prompts_output/**/imagenes/
/prompts_output/**/video/
/prompts_output/**/*.mp3
/prompts_output/**/*.mp4
/prompts_output/**/*.wav
/prompts_output/**/*_timestamps.json

# ============================================
# BACKUP
# ============================================
/prompts_output_backup/

